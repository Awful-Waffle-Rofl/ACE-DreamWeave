# Copy to `.env` on the game host (in deploy/dashboard). Never commit the real .env.

# Pin to a specific build with :sha-xxxxxxxxxxxx, or leave :latest.
DASHBOARD_IMAGE=ghcr.io/awful-waffle-rofl/waffleace-dashboard:latest

# HTTP Basic auth for the dashboard UI. Empty password => the app returns 503 (locked).
DASHBOARD_USER=admin
DASHBOARD_PASSWORD=change-me

# Password for the read-only `dashboard_ro` MySQL user (created in the README step).
DASHBOARD_DB_PASSWORD=change-me
