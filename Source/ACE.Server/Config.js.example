{
    "Server": {
        "WorldName": "ACEmulator",

        "Network": {
            // Host, default: "0.0.0.0"
            // In most cases, you will not need to change this setting. Special networking conditions, or multiple network adapters would be examples of times where you might need to change this.
            "Host": "0.0.0.0",

            // Port, default: 9000
            // This also opens the next port up, 9001, for server to client communications. When changed, it will open the port specified and +1 of that port.
            // For firewalls, you would need to include opening both ports (9000 and 9001) for communications to work correctly.
            "Port": 9000,

            "MaximumAllowedSessions": 128,
            "DefaultSessionTimeout": 60,

            // MaximumAllowedSessionsPerIPAddress, default: -1
            // -1 means unlimited connections per IP Address.
            "MaximumAllowedSessionsPerIPAddress": -1,

            // AllowUlimitedSessionsFromIPs, default []
            // Will allow the given IP addresses to have unlimited sessions - recommend only use this for Admins/Devs
            // Example: [ "127.0.0.1", "8.8.8.8" ]
            "AllowUnlimitedSessionsFromIPAddresses": []
        },

        "Accounts": {
            "OverrideCharacterPermissions": true,
            "DefaultAccessLevel": 0,
            "AllowAutoAccountCreation": true,
            "PasswordHashWorkFactor": 8,
            "ForceWorkFactorMigration": true
        },

        // The folder that contains AC DAT files (client_cell_1.dat, client_portal.dat, client_highres.dat, client_local_English.dat)
        // Note that for servers running on Linux, the ~ home folder must be fully expanded, ie. /home/user/ace/, instead of ~/ace/
        // Note that for servers running on Windows, a path like c:\ace\ MUST be entered as c:\\ace\\, replacing the single backslashes (\) with double backslashes (\\)
        "DatFilesDirectory": "c:\\ACE\\Dats\\",

        // The folder that contains Harmony mods
        "ModsDirectory": "c:\\ACE\\Mods\\",

        // ShutdownInterval, default: 60
        // Default time it will take for a server to wait before shutting down after shutdown is called from console or in game admin.
        "ShutdownInterval": "60",

        // ContainerShutdownWarningSeconds, default: 60
        // Seconds of in-game warning before a container stop (SIGTERM/SIGINT) logs players off. 0 means shut
        // down immediately with no warning. Automatically skipped when nobody is online.
        "ContainerShutdownWarningSeconds": "60",

        // WorldWatchdogEnabled, default: true
        // Master switch for the world-thread watchdog poll thread. It stamps a heartbeat file once a
        // second, logs FATAL when the world thread dies, and can take the process down.
        // Leave it on. With it off there is no heartbeat file - and the container healthcheck reads a
        // missing heartbeat file as unhealthy, so the container reports unhealthy forever - and no
        // FATAL log line when the world dies, and no self-exit.
        // It does NOT disable everything: the ace.world.* metrics and the container-stop triage in
        // Program.InitiateContainerShutdown both go through WorldWatchdog.Classify, which computes the
        // state on the calling thread from the world thread's own statics and needs no poll thread.
        // That is deliberate - a shutdown correctness fix must not be switchable off by a monitoring
        // knob. To back out only a misbehaving self-exit, use WorldWatchdogExitOnDeath.
        "WorldWatchdogEnabled": true,

        // WorldWatchdogStallSeconds, default: 60
        // Seconds since the last world tick before the world is reported as "stalled". Reporting only -
        // reaching this threshold never by itself exits the process.
        "WorldWatchdogStallSeconds": 60,

        // WorldWatchdogExitOnDeath, default: true
        // Exit the process (code 70) when the world thread has actually died - it faulted, or it stopped
        // ticking outside of a shutdown. A dead world never recovers on its own, so staying up only buys
        // a healthy-looking container that serves nobody. There is a fixed 20 second grace before the
        // exit so the fatal log line flushes and at least one metrics scrape observes the state.
        "WorldWatchdogExitOnDeath": true,

        // WorldWatchdogExitOnStallSeconds, default: 0
        // Exit the process when the world has been stalled (but not dead) for this many seconds.
        // 0 means never. Ships disabled deliberately: there is no measured baseline for the worst
        // legitimate world-thread stall, so any non-zero value here is a guess that can kill a healthy
        // server mid-hitch. Measure first, then set it.
        "WorldWatchdogExitOnStallSeconds": 0,

        // ShutdownHardDeadlineSeconds, default: 240
        // Seconds after a shutdown's countdown should have finished before the process force-exits with
        // code 71. Covers a world that hangs AFTER a normal shutdown has begun, where the waits for
        // players to log off, for landblocks to unload and for the world to stop are all unbounded.
        // The full wait is ShutdownInterval + this value.
        "ShutdownHardDeadlineSeconds": 240,

        // ShutdownDrainSeconds, default: 60
        // Cap in seconds on the wait for the shard database queue to drain during a shutdown. The cap
        // matters because stopping the shard database abandons whatever is still queued rather than
        // flushing it, so this wait is the only thing that actually saves outstanding work.
        "ShutdownDrainSeconds": 60,

        // ServerPerformanceMonitorAutoStart, default: false
        // Development recommendation: true
        // Server recommendation: true
        // Enable this to use the functionality of the command: /serverperformance
        // Additional overhead is added but it is minimal.
        // This can greatly help you (and ACE developers) understand what sections of ACE are underperforming.
        "ServerPerformanceMonitorAutoStart": false,

        // ---- Analytics (monitoring pipeline; Docs/Monitoring/DESIGN.md) ----
        // Off by default. When on, a background thread writes snapshots and event rows to the separate
        // MySql.Analytics database (see the "MySql" section below), never to the shard database.

        // EnableAnalytics, default: false
        // Master switch for everything in this block. Requires the MySql.Analytics connection to be valid;
        // if it cannot be reached at startup, analytics disables itself and the server runs normally.
        "EnableAnalytics": false,

        // AnalyticsFlushIntervalSeconds, default: 60
        // Seconds between snapshot/rate flushes. Clamped to a minimum of 10.
        "AnalyticsFlushIntervalSeconds": 60,

        // AnalyticsRetentionDays, default: 7
        // Days of raw per-character xp/lum rate rows and banked-pyreal history to keep before pruning.
        "AnalyticsRetentionDays": 7,

        // AnalyticsChatRetentionDays, default: 30
        // Days of public chat rows to keep. Separate from AnalyticsRetentionDays because chat carries
        // player speech and its volume is not bounded by the online player count.
        "AnalyticsChatRetentionDays": 30,

        // AnalyticsIpRetentionDays, default: 30
        // Days of session rows to keep. Each row holds a character's RAW login IP address, so this is kept
        // separate from the other retention keys: raw IPs must never live longer than intended just because
        // the rate tables are kept longer.
        "AnalyticsIpRetentionDays": 30,

        // AnalyticsAsnDatabasePath, default: "" (none)
        // Optional. Path to a DB-IP "IP to ASN Lite" .mmdb file (MaxMind GeoLite2 ASN works too), used to
        // record which network (ASN and organisation) each login came from. Keep it on the host beside this
        // file, NOT in the image, and do not commit it. Replace the file to refresh it (monthly); the server
        // picks up a changed file on its own. Missing or unreadable: those columns stay NULL and one warning
        // is logged. Note that DB-IP's licence (CC BY 4.0) requires crediting DB-IP.
        // Windows paths need doubled backslashes, e.g. "c:\\ACE\\asn\\dbip-asn-lite.mmdb"
        "AnalyticsAsnDatabasePath": "",

        // AnalyticsHostingAsnListPath, default: "" (none)
        // Optional. Path to a text file of hosting/VPN/datacenter ASNs: one per line, "AS13335" or "13335",
        // '#' starts a comment, blank lines are ignored. Used to flag logins from those networks. Reloaded
        // when the file changes. Missing or unreadable: the hosting flag stays NULL (unknown).
        "AnalyticsHostingAsnListPath": "",

        "Threading": {
            // This number is used to determine thread allocation for world systems (WorldObjects, Physics, etc...)
            // (Total System vCPU * WorldThreadCountMultiplier) = World Thread Count
            // (Total System vCPU - World Thread Count) = Database Thread Count
            // On larger servers, you may want to raise this to 0.5
            "WorldThreadCountMultiplier": 0.34,

            // This number is used to determine thread allocation for database operations
            // (Total System vCPU * DatabaseThreadCountMultiplier) = Database Thread Count
            "DatabaseThreadCountMultiplier": 0.66,

            // The following to booleans configure the levels of multi-threading enabled on the server
            // The server will group landblocks that are close in distance into LandblockGroups (Dungeons are always 1 per group)
            // This allows us to tick an entire LandblockGroup on a single thread
            // The thread safety boundary surrounds the LandblockGroup and separates groups from each other
            // Optionally, if the following booleans are enabled, we can tick LandblockGroups in parallel

            // This will multi-thread physics engine
            "MultiThreadedLandblockGroupPhysicsTicking": true,

            // This will multi-thread world object ticking
            // This is a much more involved process as world object ticking interacts with server global constructs like Allegiances, Fellowships, Housing, etc..
            // There is much more cross-landblock group work happening here
            "MultiThreadedLandblockGroupTicking": true
        },

        // ShardPlayerBiotaCacheTime, default: 31
        // The amount of minutes to keep in memory a player object from shard database.
        "ShardPlayerBiotaCacheTime": "31",

        // ShardNonPlayerBiotaCacheTime, default: 11
        // The amount of minutes to keep in memory a non player object from shard database.
        "ShardNonPlayerBiotaCacheTime": "11",

        // WorldDatabasePrecaching, default: false
        // Development recommendation: false
        // Server recommendation: true
        // Enable this to cache the world database at startup.
        // This will add about 1-2 minutes to server startup time and will consume about 1.7 GB of RAM
        // With this disabled, caching happens on an as-requested basis and can cause the server to feel less responsive.
        "WorldDatabasePrecaching": false,

        // LandblockPreloading, defaut: true
        // Development recommendation: true
        // Server recommendation: true
        // This makes sure that perma-load landblocks are loaded.
        // Perma-load landblocks are landblocks that can contain server-wide mechanics and should always be active.
        "LandblockPreloading": true,

        // PreloadedLandblock
        // These are the default pre-loaded and perma-loaded landblocks.
        // In most cases you should not need to adjust them.
        // This section requires LandblockPreloading to be true
        "PreloadedLandblocks": [
            {
                "Id": "E74EFFFF",
                "Description": "Hebian-To (Global Events)",
                "Permaload": true,
                "IncludeAdjacents": false,
                "Enabled": true
            },
            {
                "Id": "A9B4FFFF",
                "Description": "Holtburg",
                "Permaload": true,
                "IncludeAdjacents": true,
                "Enabled": false
            },
            {
                "Id": "DA55FFFF",
                "Description": "Shoushi",
                "Permaload": true,
                "IncludeAdjacents": true,
                "Enabled": false
            },
            {
                "Id": "7D64FFFF",
                "Description": "Yaraq",
                "Permaload": true,
                "IncludeAdjacents": true,
                "Enabled": false
            },
            {
                "Id": "0007FFFF",
                "Description": "Town Network",
                "Permaload": true,
                "IncludeAdjacents": false,
                "Enabled": false
            },
            {
                "Id": "00000000",
                "Description": "Apartment Landblocks",
                "Permaload": true,
                "IncludeAdjacents": false,
                "Enabled": false
            }
        ]
    },
  "MySql": {
    "Authentication": {
      "Host": "127.0.0.1",
      "Port": 3306,
      "Database": "ace_auth",
      "Username": "root",
      "Password": "",
      "EnableDetailedErrors": false,
      "EnableSensitiveDataLogging": false
    },
    "Shard": {
      "Host": "127.0.0.1",
      "Port": 3306,
      "Database": "ace_shard",
      "Username": "root",
      "Password": "",
      "EnableDetailedErrors": false,
      "EnableSensitiveDataLogging": false
    },
    "World": {
      "Host": "127.0.0.1",
      "Port": 3306,
      "Database": "ace_world",
      "Username": "root",
      "Password": "",
      "EnableDetailedErrors": false,
      "EnableSensitiveDataLogging": false
    },
    // Analytics: only used when Server.EnableAnalytics is true. The database is created on first start.
    "Analytics": {
      "Host": "127.0.0.1",
      "Port": 3306,
      "Database": "ace_analytics",
      "Username": "root",
      "Password": ""
    }
  },
  // This section can trigger events that may happen before the world starts up, or after it shuts down
  // The shard should be in a disconnected state from any running ACE world
  "Offline": {
    // Purge characters that have been deleted longer than PruneDeletedCharactersDays
    // These characters, and their associated biotas, will be deleted permanantly!
    "PurgeDeletedCharacters": false,

    // Number of days a character must have been deleted for before eligible for purging
    "PurgeDeletedCharactersDays": 30,

    // This will purge biotas that are completely disconnected from the world
    // These may have been items that were never deleted properly, items that were given to the town crier before delete was implemented, etc...
    // This can be time consuming so it's not something you would have set to true for every server startup. You might run this once every few months
    "PurgeOrphanedBiotas": false,

    // This will prune deleted characters from all friend lists in the database
    "PruneDeletedCharactersFromFriendLists": true,

    // This will prune shortcuts to objects that no longer exist in the database
    "PruneDeletedObjectsFromShortcutBars": false,

    // This will prune deleted characters from all squlech lists in the database, excluding those used to squlech accounts
    "PruneDeletedCharactersFromSquelchLists": false,

    // Automatically check for updated server releases. Does not apply updates, just notifies of new version available.
    "AutoServerUpdateCheck": true,

    // Automatically apply new updates to databases upon startup if they haven't yet been applied
    "AutoApplyDatabaseUpdates": true,

    // Automatically check for and update to latest available world database
    "AutoUpdateWorldDatabase": true,

    // Automatically import world customizations at startup
    // This option is independent of AutoUpdateWorldDatabase: either can be set without the other
    // Customizations are applied after AutoApplyDatabaseUpdates, so a schema migration that a
    // customization depends on has already run in the same startup
    // SQL files will be executed given the sort order of the full paths of the files
    // Files whose contents are unchanged since they were last successfully applied to this exact
    // world database are skipped, tracked via WorldCustomizationCache.json next to this config
    // (machine-local, gitignored). That cache is automatically invalidated -- forcing a full reapply --
    // whenever the target database, or its Base/Patch version, differs from what was last recorded
    // (e.g. a fresh/restored database, or a base world update was just applied this run).
    // Delete WorldCustomizationCache.json to force a full reapply manually (e.g. after a manual DB edit
    // to a customized row that you want the SQL files to overwrite again).
    "AutoApplyWorldCustomizations": true,

    // When AutoApplyWorldCustomizations is set to true, the auto apply process will search for
    // all .sql files in the following directories.
    // This process will still use ./Content by default, or the config_properties_string
    // value for 'content_folder' if it exists
    // Example: [ "C:\\MyContent", "C:\\FTPRoot\\Editor1Content", "C:\\FTPRoot\\Editor2Content" ]
    "WorldCustomizationAddedPaths": [],

     // When retrieving a file list of .sql files in the AutoApplyWorldCustomizations process
     // this will cause the file search to retrieve all files recursively from each directory
     "RecurseWorldCustomizationPaths": true
  },
  // This section configures handling of client DAT patching from server's DAT files
  "DDD": {
    // Allow server to patch client DAT files using server's DAT files via DDDManager
    "EnableDATPatching": false,

    // Upon server startup, precache all DAT files that would be sent as compressed data
    "PrecacheCompressedDATFiles": false
  },
  // Market: the web and in-game trading module (Docs/Market/DESIGN.md).
  // OFF by default. With Enabled false the server starts no listener and behaves exactly as
  // it did before the module existed.
  "Market": {
    // Enabled, default: false
    "Enabled": false,

    // ListenUrl, default: "http://127.0.0.1:5090"
    // Loopback by default so a misconfigured deployment fails closed. The container overrides
    // this to "http://+:8080" and publishes it ONLY on the compose network, never to the host.
    // Overridable at runtime by the ACE_MARKET_LISTEN_URL environment variable.
    "ListenUrl": "http://127.0.0.1:5090",

    // SharedKey: the value every request must send as X-Market-Key.
    // Supply it from the deployment .env as ACE_MARKET_SHARED_KEY, which overrides this key.
    // An empty key makes the API refuse to start rather than start unauthenticated.
    // Never commit a real key.
    "SharedKey": "",

    // MaxInFlight, default: 8
    // Concurrent request ceiling. Excess returns 429 immediately and never queues into the world.
    "MaxInFlight": 8,

    // WriteRatePerMinute, default: 120 - per-account budget for session/listings/buy/vault.
    "WriteRatePerMinute": 120,

    // RequestTimeoutMs, default: 3000
    // On expiry the client gets 503 and the enqueued work still completes or rolls back on its
    // own. It is never cancelled.
    "RequestTimeoutMs": 3000,

    // Login buckets. These count FAILED attempts too, or they do not blunt a password guess.
    "LoginRatePerMinutePerAccount": 5,

    // Per source address as the server sees it. The web app does not forward the browser's address,
    // so through it this is ONE bucket for every player, not one per player. Raise it accordingly.
    "LoginRatePerMinutePerIp": 30,

    // TrustedForwardedForSource: the ONLY address whose X-Forwarded-For is honoured, i.e. the
    // web container on the compose network. Empty ignores the header entirely.
    "TrustedForwardedForSource": "",

    // SessionLifetimeMinutes, default: 720. A restart invalidates every token regardless.
    "SessionLifetimeMinutes": 720
  }
}
